# The restaurant's keys: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnifood platforms` says what each platform can do
# with what is set; capabilities and menu:push --validate need nothing.

# Where the platforms' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIFOOD_PLUGINS=../..
# Where omnisense/contracts' checkout is (../../../omnisense-contracts beside the family's folder); unset, GitHub.
#OMNISENSE_CONTRACTS=../../../omnisense-contracts

# Uber Eats (Marketplace APIs): the Developer Dashboard application's id and
# secret (the secret also signs the webhooks), the store's id at Uber.
UBEREATS_CLIENT_ID=
UBEREATS_CLIENT_SECRET=
UBEREATS_STORE_ID=
# test-api.uber.com and sandbox-login.uber.com
UBEREATS_SANDBOX=false

# Deliveroo (Partner Platform): the Developer Portal application's id and
# secret, the brand and site ids, the menu id, the webhook secret.
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_BRAND_ID=
DELIVEROO_SITE_ID=
DELIVEROO_MENU_ID=
DELIVEROO_WEBHOOK_SECRET=
DELIVEROO_SANDBOX=true
# the site has a Deliveroo tablet: accept/deny report the till's sync status
DELIVEROO_TABLET=false

# Just Eat (JET Connect): the brand's API key, the restaurant's reference,
# what was given to JET for its webhooks (key and/or HMAC secret).
JUSTEAT_API_KEY=
JUSTEAT_RESTAURANT=
JUSTEAT_WEBHOOK_KEY=
JUSTEAT_WEBHOOK_SECRET=
JUSTEAT_CURRENCY=GBP
JUSTEAT_TIMEZONE=Europe/London

# TheFork (B2B API): the client id and secret TheFork sends, the restaurant's
# UUID, the token put in the webhook URL given to TheFork.
THEFORK_CLIENT_ID=
THEFORK_CLIENT_SECRET=
THEFORK_RESTAURANT_ID=
THEFORK_WEBHOOK_TOKEN=

# Zenchef: Settings > Partners; the address and headers come from the
# documentation Zenchef sends on request.
ZENCHEF_TOKEN=
ZENCHEF_RESTAURANT_ID=
ZENCHEF_BASE_URI=
